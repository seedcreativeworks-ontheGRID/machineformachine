# Required: your Anthropic API key. Never commit the real value.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used by the Galley AI assistant.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: the LIVE TASKS spoken step cues (every 5 seconds while the timer
# is running). Leave both unset and the feature just stays silent — no error,
# nothing breaks. Get an API key at https://elevenlabs.io, then run
# `ELEVENLABS_API_KEY=... node scripts/clone-voice.js` once to clone the
# voice from scripts/voice-sample.mp3 and get ELEVENLABS_VOICE_ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: port for the standalone Express server (server/index.js).
# Not used on Vercel, which manages its own port.
PORT=3000
