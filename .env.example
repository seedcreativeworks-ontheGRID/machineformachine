# Required: your Anthropic API key. Never commit the real value.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used by the Galley AI assistant.
ANTHROPIC_MODEL=claude-sonnet-5

# Not used by the running app — only needed locally, once, to run
# scripts/clone-voice.js and scripts/generate-cue-clips.js, which bake the
# LIVE TASKS spoken step cues into static mp3 files under
# public/audio/cues/. See "Spoken step cues" in README.md.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: port for the standalone Express server (server/index.js).
# Not used on Vercel, which manages its own port.
PORT=3000
