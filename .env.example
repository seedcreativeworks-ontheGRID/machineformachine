# Required: your Anthropic API key. Never commit the real value.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used by the Galley AI assistant.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: port for the standalone Express server (server/index.js).
# Not used on Vercel, which manages its own port.
PORT=3000
